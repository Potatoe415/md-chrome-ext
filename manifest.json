{
  "manifest_version": 3,
  "name": "Markdown Reader",
  "version": "2.0.0",
  "description": "Ouvre les fichiers Markdown (.md) dans Chrome avec le Markdown Reader de muchotools : sommaire, recherche, édition, export Word.",
  "permissions": ["scripting"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://*/*", "https://*/*"],
      "include_globs": [
        "*.md", "*.md?*",
        "*.MD", "*.MD?*",
        "*.markdown", "*.markdown?*",
        "*.mdown", "*.mdown?*",
        "*.mkd", "*.mkd?*",
        "*.mdx", "*.mdx?*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["file:///*", "http://*/*", "https://*/*"]
    }
  ]
}
